# Candidate canary settings; not loaded by production compose.
NODE_HEAVY_CONCURRENCY=3
NODE_CLEANUP_CONCURRENCY=2
NODE_PRESSURE_ENABLED=false
# Verify these paths INSIDE the Runner before enabling pressure:
NODE_PRESSURE_PROC_ROOT=/proc
NODE_PRESSURE_DISK_PATH=/var/lib/docker
NODE_MIN_MEMORY_PERCENT=10
NODE_MIN_DISK_PERCENT=10
NODE_MIN_INODE_PERCENT=5
NODE_MAX_IO_PSI=20
# CPU PSI is optional; 0 disables this measurement.
NODE_MAX_CPU_PSI=0
